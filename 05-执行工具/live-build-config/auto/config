#!/bin/sh
# auto/config —— live-build 构建配置（P2-L1）
#
# 目标产物：AI-Repair-Live.iso（由 build.sh 从 lb 产物改名而来）
#   基座：Debian 12 bookworm / amd64 / Xfce 精简桌面
#   引导：syslinux（Legacy BIOS）+ grub-efi（UEFI）双启动，iso-hybrid 可被 Ventoy 直接加载
#   中文：默认 locale zh_CN.UTF-8（内核启动参数 + hook 0400 双保险）
#   用户：live 用户无密码自动登录（密码由 hook 0300 passwd -d 清空，自动登录由 hook 0300 配 lightdm）
#   压缩：xz（体积优先，构建慢一些换 U 盘空间）
#
# 镜像命名规范（实施计划 P1 产物版本与回滚规范）：
#   AI-Repair-Live-v<版本>-<日期>，例如 AI-Repair-Live-v0.1-20260912
#   lb build 实际产物为 <image-name>-amd64.hybrid.iso，build.sh 负责：
#     1) 改名为 ../dist/AI-Repair-Live-v0.1-20260912.iso
#     2) 同时生成 AI-Repair-Live-v0.1-20260912.iso.sha256（sha256sum，供制作端/下载端校验）
#   升级版本时：同步修改 build.sh 顶部的 IMAGE_VERSION / IMAGE_DATE 与本文件的 --image-name。

set -e

MIRROR="https://mirrors.aliyun.com/debian"
MIRROR_SEC="https://mirrors.aliyun.com/debian-security"

lb config noauto \
    --distribution bookworm \
    --parent-distribution bookworm \
    --architectures amd64 \
    --binary-images iso-hybrid \
    --bootloaders syslinux,grub-efi \
    --archive-areas "main contrib non-free non-free-firmware" \
    --security true \
    --updates true \
    --backports false \
    --debian-installer none \
    --mirror-bootstrap "$MIRROR" \
    --mirror-chroot "$MIRROR" \
    --mirror-chroot-security "$MIRROR_SEC" \
    --mirror-binary "$MIRROR" \
    --mirror-binary-security "$MIRROR_SEC" \
    --bootappend-live "boot=live components username=live hostname=ai-repair locales=zh_CN.UTF-8 keyboard-layouts=cn" \
    --compression xz \
    --image-name "AI-Repair-Live-v0.3-20261014" \
    --iso-application "AI Repair Live" \
    --iso-publisher "AI-Repair Project" \
    --iso-volume "AI-Repair-Live-v0.3" \
    "${@}"
